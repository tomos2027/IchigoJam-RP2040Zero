10 '=== IchigoJam/Milkjam ｺｳｶｵﾝｻﾝﾌﾟﾙｼｭｳ ===
20 ' (ﾓﾄ: MSX-BASIC SOUNDﾒｲﾚｲ ｻﾝﾌﾟﾙｦ IchigoJam ﾑｹﾆｼｭｳｾｲ)
25 ' ｺﾉFWﾉPSG: freq=1777778/(2*period)  MSXﾉTPﾊ*8 (periodﾊ12bit)
30 ?"SOUND EFFECT SAMPLES"
40 ?"1:PICO 2:BUU 3:SHAKIIN"
50 ?"4:DOKAAN 5:PWRUP 6:COIN"
55 ?"7:JUMP 8:ZUBEN 9:GOBGOB"
56 ?"0:TERETEE"
60 ?"other key = exit"
70 K=INKEY()
80 IF K=0 GOTO 70
90 IF K=49 GOSUB 1000
100 IF K=50 GOSUB 1100
110 IF K=51 GOSUB 1200
120 IF K=52 GOSUB 1300
130 IF K=53 GOSUB 1400
140 IF K=54 GOSUB 1700
141 IF K=55 GOSUB 2000
142 IF K=56 GOSUB 2100
143 IF K=57 GOSUB 2200
144 IF K=48 GOSUB 2302
150 IF K>=48 AND K<=57 GOTO 70
160 SOUND 8,0 : SOUND 9,0
170 END

1000 '--- 1. PICO (ｹｯﾃｲｵﾝ) ---
1010 SOUND 7,254:                    ' R7: chAﾄｰﾝﾉﾐﾕｳｺｳ
1020 SOUND 0,(#40*4) AND 255 : SOUND 1,(#40*4)/256:   ' period 64*4=256
1030 SOUND 8,15
1040 WAIT 4
1050 SOUND 8,0
1060 RETURN

1100 '--- 2. BUU (ｴﾗｰｵﾝ) ---
1110 SOUND 7,254:                    ' R7: chAﾄｰﾝﾉﾐﾕｳｺｳ
1120 SOUND 0,(#350*4) AND 255 : SOUND 1,(#350*4)/256:  ' period 848*4=3392 (ﾃｲｵﾝ)
1130 SOUND 8,10
1140 WAIT 45
1150 SOUND 8,0
1160 RETURN

1200 '--- 3. SHAKIIN (ｼﾞｮｳｼｮｳｵﾝ) ---
1210 SOUND 7,254
1220 SOUND 8,15
1230 FOR V=255 TO 20 STEP -15
1240 SOUND 0,(V*4) AND 255 : SOUND 1,(V*4)/256:       ' ﾋﾟﾘｵﾄﾞｦﾁｲｻｸ=ｺｳｵﾝﾍ
1250 WAIT 1
1260 NEXT
1270 SOUND 8,0
1280 RETURN

1300 '--- 4. DOKAAN (ﾊﾞｸﾊﾂｵﾝ) ---
1310 SOUND 7,238:                    ' R7: chAﾄｰﾝ + chBﾉｲｽﾞ (bit0,4=0)
1320 SOUND 6,16:                     ' R6: ﾉｲｽﾞｼｭｳｷ
1330 SOUND 0,(#300*4) AND 255 : SOUND 1,(#300*4)/256:  ' chA ﾃｲｵﾝ period 768*4=3072
1340 FOR W=15 TO 0 STEP -1
1350 SOUND 8,W : SOUND 9,W:         ' chAﾄｰﾝ/chBﾉｲｽﾞｦｹﾞﾝｽｲ
1360 WAIT 2
1370 NEXT
1380 SOUND 8,0 : SOUND 9,0
1390 RETURN

1400 '--- 5. POWER UP (ﾊﾟﾜｰｱｯﾌﾟ) ---
1410 SOUND 7,254
1420 SOUND 8,15
1430 P=#C0:D=4:GOSUB 1600
1440 P=#B0:D=4:GOSUB 1600
1450 P=#A0:D=4:GOSUB 1600
1460 P=#90:D=4:GOSUB 1600
1470 P=#80:D=4:GOSUB 1600
1480 P=#70:D=4:GOSUB 1600
1490 P=#60:D=4:GOSUB 1600
1500 P=#50:D=4:GOSUB 1600
1510 P=#48:D=8:GOSUB 1600
1520 P=#40:D=8:GOSUB 1600
1530 P=#38:D=12:GOSUB 1600
1540 SOUND 8,0
1550 RETURN

1600 ' 1ｵﾝﾍﾙﾊﾟ: P=MSX AYﾋﾟﾘｵﾄﾞ, D=ﾅｶﾞｻ(ﾌﾚｰﾑ)
1610 SOUND 0,(P*4) AND 255 : SOUND 1,(P*4)/256
1620 WAIT D
1630 RETURN

1700 '--- 6. COIN (ｺｲﾝｼｭﾄｸｵﾝ B5->E6) ---
1710 SOUND 7,254:                    ' R7: chAﾄｰﾝﾉﾐﾕｳｺｳ
1720 SOUND 8,15
1730 SOUND 0,132 : SOUND 1,3:        ' period 900 = 988Hz (B5)
1740 WAIT 4
1750 SOUND 0,162 : SOUND 1,2:        ' period 674 = 1319Hz (E6)
1760 WAIT 14
1770 SOUND 8,0
1780 RETURN

2000 '--- 7. JUMP (ｼﾞｬﾝﾌﾟ ｼｬｷﾝｼﾞｮｳｼｮｳ) ---
2010 SOUND 7,254
2020 SOUND 8,14
2030 FOR V=200 TO 56 STEP -8
2040 SOUND 0,(V*4) AND 255 : SOUND 1,(V*4)/256
2050 WAIT 1
2060 NEXT
2070 SOUND 8,0
2080 RETURN

2100 '--- 8. ZUBEN (ｽﾞﾋﾞｰﾝ ｶｸｶｽｲｰﾌﾟ) ---
2110 SOUND 7,254
2120 SOUND 8,14
2130 FOR V=56 TO 248 STEP 8
2140 SOUND 0,(V*4) AND 255 : SOUND 1,(V*4)/256
2150 WAIT 1
2160 NEXT
2170 SOUND 8,0
2180 RETURN

2200 '--- 9. GOBGOB (ｺﾞﾌﾞｺﾞﾌﾞ ﾃｲｵﾝ+ﾉｲｽﾞ) ---
2210 SOUND 7,246:                    ' R7: chA ﾄｰﾝ+ﾉｲｽﾞ (bit0,3=0)
2220 SOUND 6,16:                     ' R6: ﾉｲｽﾞｼｭｳｷ
2230 SOUND 8,15
2240 FOR I=1 TO 3
2250 SOUND 0,64 : SOUND 1,15:        ' period 3904 = 228Hz
2260 WAIT 8
2270 SOUND 0,196 : SOUND 1,9:        ' period 2500 = 356Hz
2280 WAIT 8
2290 NEXT
2292 FOR W=15 TO 0 STEP -3
2294 SOUND 8,W
2296 WAIT 2
2298 NEXT
2299 SOUND 8,0
2300 RETURN

2302 '--- 10. TERETEE (ｼｮｳﾘｼﾞｬﾝｸﾞ G-C-E-G-C) ---
2310 SOUND 7,252:                    ' R7: chA+chB ﾄｰﾝ (bit0,1=0)
2320 SOUND 8,15 : SOUND 9,0
2330 SOUND 0,220 : SOUND 1,8:        ' period 2268 = 392Hz  G4
2340 WAIT 4
2350 SOUND 0,163 : SOUND 1,6:        ' period 1699 = 523Hz  C5
2360 WAIT 4
2370 SOUND 0,68 : SOUND 1,5:         ' period 1348 = 659Hz  E5
2380 WAIT 4
2390 SOUND 0,110 : SOUND 1,4:        ' period 1134 = 784Hz  G5
2400 WAIT 4
2410 SOUND 0,81 : SOUND 1,3:         ' period 849 = 1047Hz  C6
2420 WAIT 8
2430 SOUND 2,162 : SOUND 3,2:        ' chB period 674 = 1319Hz E6
2435 SOUND 9,10
2440 WAIT 12
2450 SOUND 8,0 : SOUND 9,0
2460 RETURN
