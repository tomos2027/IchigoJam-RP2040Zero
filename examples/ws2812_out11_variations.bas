10 '=== Milkjam: WS2812 x8 on OUT5 (GP22) ===
20 'WS.LED port,n : port 5 = OUT5 / n = 8 LEDs
30 'color data: [i*3]=G [i*3+1]=R [i*3+2]=B (GRB)
40 CLV
50 WS.LED 5,8
60 B=40
70 P=0
100 FOR J=0 TO 23:[J]=0:NEXT
110 IF P=0 GSB 200
120 IF P=1 GSB 250
130 IF P=2 GSB 300
140 IF P=3 GSB 350
150 IF P=4 GSB 400
160 IF P=5 GSB 450
170 IF P=6 GSB 500
180 P=P+1
190 IF P=7 P=0
195 GOTO 100
200 'P0: blink all (G,R,B)
210 FOR C=0 TO 2
220 FOR T=1 TO 2
230 FOR I=0 TO 7:[I*3+C]=B:NEXT
232 WS.LED 5,8
234 WAIT 30
236 FOR I=0 TO 23:[I]=0:NEXT
238 WS.LED 5,8
240 WAIT 30
242 NEXT
244 NEXT
246 RTN
250 'P1: running light
260 FOR T=1 TO 3
270 FOR I=0 TO 7
272 FOR J=0 TO 23:[J]=0:NEXT
274 [I*3+1]=B
276 WS.LED 5,8
278 WAIT 10
280 NEXT
282 NEXT
284 RTN
300 'P2: comet (head + tail)
310 FOR T=1 TO 3
320 FOR I=0 TO 7
322 FOR J=0 TO 23:[J]=0:NEXT
324 [I*3+1]=B
326 [((I+7)%8)*3+1]=B/2
328 [((I+6)%8)*3+1]=B/4
330 WS.LED 5,8
332 WAIT 12
334 NEXT
336 NEXT
338 RTN
350 'P3: rainbow flow (6 colors)
360 LET [300],0,B,0
362 LET [303],B,B,0
364 LET [306],B,0,0
366 LET [309],B,0,B
368 LET [312],0,0,B
370 LET [315],0,B,B
372 FOR T=1 TO 4
374 FOR S=0 TO 5
376 FOR I=0 TO 7
378 H=(S+I)%6
380 FOR K=0 TO 2
382 [I*3+K]=[300+H*3+K]
384 NEXT
386 NEXT
388 WS.LED 5,8
390 WAIT 15
392 NEXT
394 NEXT
396 RTN
400 'P4: symmetric wave (blue)
410 FOR T=1 TO 3
420 FOR K=0 TO 3
422 [(3-K)*3+2]=B:[(4+K)*3+2]=B
424 WS.LED 5,8
426 WAIT 20
428 NEXT
430 FOR K=0 TO 3
432 [(3-K)*3+2]=0:[(4+K)*3+2]=0
434 WS.LED 5,8
436 WAIT 20
438 NEXT
440 NEXT
442 RTN
450 'P5: alternate blink (red/blue)
460 FOR T=1 TO 6
470 FOR I=0 TO 3
472 [I*6+1]=B
474 [I*6+5]=B
476 NEXT
478 WS.LED 5,8
480 WAIT 20
482 FOR I=0 TO 23:[I]=0:NEXT
484 FOR I=0 TO 3
486 [I*6+2]=B
488 [I*6+4]=B
490 NEXT
492 WS.LED 5,8
494 WAIT 20
496 NEXT
498 RTN
500 'P6: breathing (red fade)
510 FOR S=5 TO 40 STEP 5
520 FOR I=0 TO 7:[I*3+1]=S:NEXT
530 WS.LED 5,8
540 WAIT 6
550 NEXT
560 FOR S=35 TO 0 STEP -5
570 FOR I=0 TO 7:[I*3+1]=S:NEXT
580 WS.LED 5,8
590 WAIT 6
600 NEXT
610 RTN
