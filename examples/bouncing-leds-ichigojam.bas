10 'BOUNCING LEDS (MachiKania TYPE P DEMO PORT)
20 'FOR ICHIGOJAM 4K WS.LED - MAX 119 LED
30 CLV
40 L=119:K=8:H=60:W=20
50 P=3:Q=5:O=-80:E=0:S=7:C=1
60 'L:LEDNUM K:BLOCK H:BRIGHT W:GRAVITY
70 'P/Q:BOUNCE O:REFMIN E:REVERSE S:PORT C:COLOR
80 D=L<<8
90 IF D>0 GOSUB 300
100 IF D>0 GOTO 90
110 WS.LED 5,S,L
120 WAIT 30
130 'PHASE2: SLIDE OFF
140 Y=0:V=0
150 IF Y>=L*256 GOTO 230
160 Y=Y+V:V=V+W/2
170 FOR I=L-1 TO Y>>8 STEP -1
180  X=I*256+(Y&255)-V
190  IF X>=Y GSB 500
200  IF X<Y GOSUB 560
210  NEXT
215 WS.LED 5,S,L
220 GOTO 150
230 WAIT 30
240 GOTO 80
300 'FALL ONE BLOCK (D=BOTTOM C=COLOR)
310 Y=0:V=0
320 IF Y>=D GOTO 395
330 M=Y>>8:F=C:GSB 600
340 WS.LED 5,S,L
350 M=Y>>8:F=0:GSB 600
360 V=V+W:Y=Y+V
370 IF Y<D GOTO 320
380 Y=D-256:V=-V*P/Q
385 IF V<=O GOTO 320
388 M=(D>>8)-1:F=C:GSB 600:D=D-K*256:C=(C+18)%24+1
390 GOTO 320
395 RTN
500 'CPYLED (X>>8)TO I (E:REVERSE)
510 M=X>>8:N=I
520 IF E M=L-M-1
530 IF E N=L-N-1
540 [N*3]=[M*3]:[N*3+1]=[M*3+1]:[N*3+2]=[M*3+2]
550 RTN
560 'CLEAR LED I (E:REVERSE)
570 A=I:IF E A=L-A-1
580 [A*3]=0:[A*3+1]=0:[A*3+2]=0
590 RTN
600 'SETBLOCK M:POS F:COLOR
610 R=0:G=0:B=0
620 IF F=0 GOTO 670
630 IF F>24 RTN
640 IF F<=8 R=(8-F)*H/8:G=F*H/8:B=0:GOTO 670
650 IF F<=16 R=0:G=(16-F)*H/8:B=(F-8)*H/8:GOTO 670
660 R=(F-16)*H/8:G=0:B=(24-F)*H/8
670 FOR J=0 TO K-1
680  IF M<0 GOTO 720
690  A=M:IF E A=L-A-1
700  [A*3]=G:[A*3+1]=R:[A*3+2]=B
710  M=M-1
720  NEXT
730 RTN
