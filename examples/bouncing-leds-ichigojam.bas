10 'BOUNCING LEDS FOR ICHIGOJAM RP2040ZERO
20 '119 LED / GP12 (OUT5) = WS.LED 5 / GRB
30 'ARRAY [0..356] - WORKS ON STOCK FIRMWARE ([0..357])
40 '144 LED NEEDS EXTENDED FW ([0..431]): SET L=144 ON LINE 60
50 CLV
60 L=119:K=8:H=20:W=10: 'L:LEDS K:BLOCK H:BRIGHT W:GRAVITY
70 P=3:Q=5:O=-80:E=0:S=5:C=1
80 'P/Q:BOUNCE O:MINV E:REVERSE S:PORT C:COLOR Z:LASTPOS
90 'FIXED POINT 1/128 (256 WOULD OVERFLOW 16BIT)
100 D=L*128
110 IF D>0 GOSUB 300
120 IF D>0 GOTO 110
130 WS.LED S,L
140 WAIT 30
150 'PHASE 2: SLIDE ALL LEDS OFF
160 Y=0:V=0
170 Y=Y+V:V=V+W/2
180 IF Y>=L*128 GOTO 250
190 FOR I=L-1 TO Y>>7 STEP -1
200  X=I*128+(Y&127)-V
210  IF X>=Y GSB 500
220  IF X<Y GOSUB 560
230  NEXT
240 WS.LED S,L
245 GOTO 170
250 WS.LED S,L
260 WAIT 30
270 GOTO 100
300 'FALL ONE BLOCK (D=BOTTOM, C=COLOR)
310 Y=0:V=0
320 IF Y>=D GOTO 395
330 M=Y>>7:F=C:GSB 600
340 WS.LED S,L
350 M=Y>>7:F=0:GSB 600
360 V=V+W:Y=Y+V
365 IF Y<D GOTO 320
370 Y=D-128:V=-V*P/Q 
375 IF V<=O GOTO 320
380 M=(D>>7)-1:F=C:GSB 600:D=D-K*128:C=(C+18)%24+1
390 GOTO 320
395 RTN
500 'CPY LED (X>>7) TO I
510 M=X>>7:N=I
520 IF E M=L-M-1
530 IF E N=L-N-1
540 [N*3]=[M*3]:[N*3+1]=[M*3+1]:[N*3+2]=[M*3+2]
550 RTN
560 'CLEAR LED I
570 A=I:IF E A=L-A-1
580 [A*3]=0:[A*3+1]=0:[A*3+2]=0
590 RTN
600 'SET BLOCK M=POS F=COLOR
610 R=0:G=0:B=0
620 IF F=0 GOTO 670
630 IF F>24 GOTO 730
640 IF F<=8 R=(8-F)*H/8:G=F*H/8:B=0:GOTO 670
650 IF F<=16 R=0:G=(16-F)*H/8:B=(F-8)*H/8:GOTO 670
660 R=(F-16)*H/8:G=0:B=(24-F)*H/8
670 FOR J=0 TO K-1
680  IF M<0 GOTO 720
690  A=M:IF E A=L-A-1
700  [A*3]=G:[A*3+1]=R:[A*3+2]=B
710  M=M-1
720  NEXT
730 RTN
